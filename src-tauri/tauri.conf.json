{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xlsx2md",
  "version": "2.0.0",
  "identifier": "net.cuio.xlsx2md",
  "build": {
    "beforeDevCommand": "node scripts/sync-dist.cjs",
    "beforeBuildCommand": "node scripts/sync-dist.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "XLSX to Markdown",
        "width": 960,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
